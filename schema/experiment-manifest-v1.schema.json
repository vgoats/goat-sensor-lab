{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vgoats/goat-sensor-lab/blob/main/schema/experiment-manifest-v1.schema.json",
  "title": "Goat Sensor Lab experiment/session manifest v1",
  "description": "Versioned reproducibility manifest. Every listed field is required; unknown, not-applicable, or withheld values are null and must be explained in missingness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_schema_version", "experiment_id", "manifest_revision", "supersedes_manifest_sha256", "created_at", "protocol", "session", "animal", "sensor", "calibration", "cameras", "video_absence_reason", "annotation", "husbandry", "study_design", "missingness", "notes"],
  "properties": {
    "manifest_schema_version": {"const": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "manifest_revision": {"type": "integer", "minimum": 1},
    "supersedes_manifest_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "protocol": {"$ref": "#/$defs/protocol"},
    "session": {"$ref": "#/$defs/session"},
    "animal": {"$ref": "#/$defs/animal"},
    "sensor": {"$ref": "#/$defs/sensor"},
    "calibration": {"$ref": "#/$defs/calibration"},
    "cameras": {"type": "array", "items": {"$ref": "#/$defs/camera"}},
    "video_absence_reason": {"type": ["string", "null"]},
    "annotation": {"$ref": "#/$defs/annotation"},
    "husbandry": {"$ref": "#/$defs/husbandry"},
    "study_design": {"$ref": "#/$defs/studyDesign"},
    "missingness": {"type": "array", "items": {"$ref": "#/$defs/missingness"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"], "minLength": 1},
    "nullableNumber": {"type": ["number", "null"]},
    "nullableInteger": {"type": ["integer", "null"]},
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol_id", "version", "title", "registration_uri", "registered_at", "ethics_approval_ids", "primary_endpoint", "analysis_plan_uri", "sample_size_method", "inclusion_criteria", "exclusion_criteria", "randomization_method", "blinding_method", "minimum_double_annotation_fraction", "stopping_rules", "habituation_plan", "counterbalancing_plan"],
      "properties": {
        "protocol_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1},
        "registration_uri": {"$ref": "#/$defs/nullableString"}, "registered_at": {"type": ["string", "null"], "format": "date-time"},
        "ethics_approval_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "primary_endpoint": {"type": "string", "minLength": 1}, "analysis_plan_uri": {"$ref": "#/$defs/nullableString"}, "sample_size_method": {"type": "string", "minLength": 1},
        "inclusion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "exclusion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "randomization_method": {"type": "string", "minLength": 1}, "blinding_method": {"type": "string", "minLength": 1}, "minimum_double_annotation_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "stopping_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "habituation_plan": {"type": "string", "minLength": 1}, "counterbalancing_plan": {"type": "string", "minLength": 1}
      }
    },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "farm_id", "site_id", "shed_id", "pen_id", "timezone", "start_time", "end_time", "source_export_schema_version", "raw_export_sha256"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1}, "farm_id": {"$ref": "#/$defs/nullableString"}, "site_id": {"$ref": "#/$defs/nullableString"}, "shed_id": {"$ref": "#/$defs/nullableString"}, "pen_id": {"$ref": "#/$defs/nullableString"},
        "timezone": {"type": "string", "minLength": 1}, "start_time": {"type": ["string", "null"], "format": "date-time"}, "end_time": {"type": ["string", "null"], "format": "date-time"},
        "source_export_schema_version": {"type": "integer", "minimum": 1}, "raw_export_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 of the exact canonical samples.csv bytes supplied to research analysis."}
      }
    },
    "animal": {
      "type": "object", "additionalProperties": false,
      "required": ["animal_id", "species", "breed", "sex", "birth_date", "age_days_at_start", "body_mass_kg", "life_stage", "health_status", "treatments"],
      "properties": {
        "animal_id": {"type": "string", "minLength": 1}, "species": {"enum": ["GOAT", "SHEEP"]}, "breed": {"$ref": "#/$defs/nullableString"},
        "sex": {"enum": ["FEMALE", "MALE", "CASTRATED_MALE", "INTERSEX", "UNKNOWN"]}, "birth_date": {"type": ["string", "null"], "format": "date"}, "age_days_at_start": {"$ref": "#/$defs/nullableInteger"},
        "body_mass_kg": {"$ref": "#/$defs/nullableNumber"}, "life_stage": {"enum": ["JUVENILE", "ADULT", "GESTATING", "LACTATING", "DRY", "UNKNOWN"]},
        "health_status": {"$ref": "#/$defs/nullableString"}, "treatments": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sensor": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "device_id", "hardware_revision", "firmware_version", "firmware_commit", "app_version", "app_commit", "ble_protocol_version", "placement", "placement_side", "orientation_description", "enclosure_id", "enclosure_version", "enclosure_mass_g", "requested_sample_rate_hz", "achieved_sample_rate_hz", "accelerometer_range_g", "gyroscope_range_deg_s", "capabilities_sha256", "device_dropped_samples"],
      "properties": {
        "source": {"enum": ["ANDROID_PHONE", "XIAO_NRF52840_SENSE"]}, "device_id": {"type": "string", "minLength": 1}, "hardware_revision": {"$ref": "#/$defs/nullableString"},
        "firmware_version": {"$ref": "#/$defs/nullableString"}, "firmware_commit": {"$ref": "#/$defs/nullableString"}, "app_version": {"$ref": "#/$defs/nullableString"}, "app_commit": {"$ref": "#/$defs/nullableString"}, "ble_protocol_version": {"$ref": "#/$defs/nullableInteger"},
        "placement": {"enum": ["PHONE_HANDHELD_TEST", "NECK_COLLAR", "EAR_MOUNT", "BODY_HARNESS"]}, "placement_side": {"$ref": "#/$defs/nullableString"}, "orientation_description": {"$ref": "#/$defs/nullableString"},
        "enclosure_id": {"$ref": "#/$defs/nullableString"}, "enclosure_version": {"$ref": "#/$defs/nullableString"}, "enclosure_mass_g": {"$ref": "#/$defs/nullableNumber"},
        "requested_sample_rate_hz": {"$ref": "#/$defs/nullableNumber"}, "achieved_sample_rate_hz": {"$ref": "#/$defs/nullableNumber"}, "accelerometer_range_g": {"$ref": "#/$defs/nullableNumber"}, "gyroscope_range_deg_s": {"$ref": "#/$defs/nullableNumber"},
        "capabilities_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "device_dropped_samples": {"$ref": "#/$defs/nullableInteger"}
      }
    },
    "calibration": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "calibration_id", "method_uri", "performed_at", "coefficient_artifact_uri", "coefficient_artifact_sha256", "applied_to_raw_export", "operator_id", "temperature_c"],
      "properties": {
        "status": {"enum": ["UNCALIBRATED", "FACTORY_SPECIFICATION_ONLY", "PROJECT_CALIBRATED", "UNKNOWN"]}, "calibration_id": {"$ref": "#/$defs/nullableString"}, "method_uri": {"$ref": "#/$defs/nullableString"},
        "performed_at": {"type": ["string", "null"], "format": "date-time"}, "coefficient_artifact_uri": {"$ref": "#/$defs/nullableString"}, "coefficient_artifact_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "applied_to_raw_export": {"type": "boolean"}, "operator_id": {"$ref": "#/$defs/nullableString"}, "temperature_c": {"$ref": "#/$defs/nullableNumber"}
      }
    },
    "camera": {
      "type": "object", "additionalProperties": false,
      "required": ["camera_id", "position", "media_uri", "media_sha256", "frame_rate_hz", "resolution", "clock_source", "media_clock", "clock_mapping_id", "clock_mapping_uri", "clock_mapping_sha256", "dropped_frame_assessment"],
      "properties": {
        "camera_id": {"type": "string", "minLength": 1}, "position": {"type": "string", "minLength": 1}, "media_uri": {"$ref": "#/$defs/nullableString"}, "media_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "frame_rate_hz": {"$ref": "#/$defs/nullableNumber"}, "resolution": {"$ref": "#/$defs/nullableString"}, "clock_source": {"$ref": "#/$defs/nullableString"}, "media_clock": {"enum": ["VIDEO_PTS_MS", "VIDEO_FRAME_INDEX", "AUDIO_PTS_MS"]}, "clock_mapping_id": {"$ref": "#/$defs/nullableString"}, "clock_mapping_uri": {"$ref": "#/$defs/nullableString"}, "clock_mapping_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "dropped_frame_assessment": {"$ref": "#/$defs/nullableString"}
      }
    },
    "annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["ethogram_id", "ethogram_version", "tool", "tool_version", "rater_ids", "planned_double_annotation_fraction", "achieved_double_annotation_fraction", "consensus_method", "consensus_method_version", "blinded_to_model_outputs", "raters_blinded_to_each_other"],
      "properties": {
        "ethogram_id": {"type": "string", "minLength": 1}, "ethogram_version": {"type": "string", "minLength": 1}, "tool": {"$ref": "#/$defs/nullableString"}, "tool_version": {"$ref": "#/$defs/nullableString"},
        "rater_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "planned_double_annotation_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "achieved_double_annotation_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "consensus_method": {"$ref": "#/$defs/nullableString"}, "consensus_method_version": {"$ref": "#/$defs/nullableString"}, "blinded_to_model_outputs": {"type": ["boolean", "null"]}, "raters_blinded_to_each_other": {"type": ["boolean", "null"]}
      }
    },
    "husbandry": {
      "type": "object", "additionalProperties": false,
      "required": ["ration_description", "feed_delivery_schedule", "water_access", "housing_conditions", "ambient_conditions_uri"],
      "properties": {
        "ration_description": {"$ref": "#/$defs/nullableString"}, "feed_delivery_schedule": {"$ref": "#/$defs/nullableString"}, "water_access": {"$ref": "#/$defs/nullableString"}, "housing_conditions": {"$ref": "#/$defs/nullableString"}, "ambient_conditions_uri": {"$ref": "#/$defs/nullableString"}
      }
    },
    "studyDesign": {
      "type": "object", "additionalProperties": false,
      "required": ["study_arm", "device_allocation_method", "mount_order", "session_order_method", "operator_id"],
      "properties": {
        "study_arm": {"type": "string", "minLength": 1}, "device_allocation_method": {"$ref": "#/$defs/nullableString"}, "mount_order": {"$ref": "#/$defs/nullableString"}, "session_order_method": {"$ref": "#/$defs/nullableString"}, "operator_id": {"$ref": "#/$defs/nullableString"}
      }
    },
    "missingness": {
      "type": "object", "additionalProperties": false,
      "required": ["json_pointer", "status", "reason"],
      "properties": {
        "json_pointer": {"type": "string", "pattern": "^/"}, "status": {"enum": ["UNKNOWN", "NOT_APPLICABLE", "WITHHELD"]}, "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "x-invariants": [
    "Every null value must have exactly one matching JSON Pointer entry in missingness.",
    "Pseudonymous IDs are used in exported research artifacts; identifying lookup tables remain access controlled.",
    "A changed manifest is a new immutable revision with the prior canonical JSON SHA-256 in supersedes_manifest_sha256.",
    "planned_double_annotation_fraction is at least protocol.minimum_double_annotation_fraction; achieved_double_annotation_fraction is recomputed from active non-adjudicator rater intervals rather than trusted as a declaration.",
    "applied_to_raw_export=false for current raw SI-converted phone/XIAO measurements unless a validated project calibration transform was actually applied."
  ]
}
